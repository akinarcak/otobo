<div id='oooFooter'>
    <div>
        <div id='oooCopyright'>
            <p class='ooo10g'>© 2026 CareOnCloud ESM</p>
            <a href="https://esm.arcak.net" target="_blank" aria-label="CareOnCloud ESM">
                <img src="[% Config("Frontend::WebPath") %]skins/Customer/default/img/careoncloud-logo.png" alt="CareOnCloud ESM" />
            </a>
        </div>
        <div id='FooterLinks'>
[% IF(Data.FooterLinks) %]
    [% FOREACH Link IN Data.FooterLinks %]
            <a href="[% Link.Target | html %]" target="_blank" class="ooo10g">[% Link.Description | Translate | html %]</a>
    [% END %]
[% END %]
        </div>
        <div id='ooo'>
            <p class='ooo10g'>powered by <a href="https://esm.arcak.net" target="_blank">CareOnCloud ESM</a></p>
        </div>
    </div>
</div>

[% InsertTemplate("CustomerFooterJS.tt") %]

</body>
</html>
