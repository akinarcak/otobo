<div class="MainBox ARIARoleMain"><h1>[% Translate("CareOnCloud Agent Assistant") | html %]</h1><div class="WidgetSimple"><div class="Header"><h2>[% Translate("Describe the issue") | html %]</h2></div><div class="Content"><form action="[% Env("CGIHandle") %]" method="get"><input type="hidden" name="Action" value="AgentCareOnCloudAssist"/><label for="AssistTenant">[% Translate("Customer") | html %]</label><select id="AssistTenant" name="TenantID">[% RenderBlockStart("TenantOption") %]<option value="[% Data.TenantID | html %]" [% Data.Selected | html %]>[% Data.TenantID | html %]</option>[% RenderBlockEnd("TenantOption") %]</select><label for="AssistQuery">[% Translate("Issue description") | html %]</label><textarea id="AssistQuery" name="Query" maxlength="500" required>[% Data.Query | html %]</textarea><button class="Button" type="submit">[% Translate("Find similar resolutions") | html %]</button></form><p>[% Translate("Tenant data stays inside CareOnCloud; recommendations are evidence-based and require agent review.") | html %]</p></div></div>[% IF Data.Searched %]<div class="WidgetSimple"><div class="Header"><h2>[% Translate("Suggestions") | html %] ([% Data.ResultCount | html %])</h2></div><div class="Content">[% RenderBlockStart("Suggestion") %]<article class="CareOnCloudAssistSuggestion"><h3>[% Data.RequestNumber | html %] — [% Data.CatalogItem | html %]</h3><p><strong>[% Translate("Confidence") | html %]:</strong> [% Data.Confidence | html %]% · <strong>[% Translate("Evidence") | html %]:</strong> [% Data.Evidence | html %]</p><p><strong>[% Translate("Reusable resolution") | html %]:</strong> [% Data.SolutionSummary | html %]</p></article>[% RenderBlockEnd("Suggestion") %]</div></div>[% END %]</div>
