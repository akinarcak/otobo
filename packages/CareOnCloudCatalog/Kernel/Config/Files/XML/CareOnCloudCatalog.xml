<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_config version="2.0" init="Application">
    <Setting Name="CareOnCloud::Catalog::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enables the tenant-safe CareOnCloud service catalog repository.</Description>
        <Navigation>Core::CareOnCloud::Catalog</Navigation>
        <Value>
            <Item ValueType="Checkbox">1</Item>
        </Value>
    </Setting>
    <Setting Name="CareOnCloud::Catalog::ListLimit" Required="1" Valid="1">
        <Description Translatable="1">Maximum number of records returned by a catalog list operation.</Description>
        <Navigation>Core::CareOnCloud::Catalog</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^(?:[1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$">200</Item>
        </Value>
    </Setting>
    <Setting Name="CustomerFrontend::Module###CustomerCareOnCloudCatalog" Required="0" Valid="1">
        <Description Translatable="1">Tenant-safe CareOnCloud service catalog for the customer portal.</Description>
        <Navigation>Frontend::Customer::ModuleRegistration</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group"><Array></Array></Item>
                    <Item Key="GroupRo"><Array></Array></Item>
                    <Item Key="Description" Translatable="1">Browse services and requestable catalog items.</Item>
                    <Item Key="NavBarName">CareOnCloudCatalog</Item>
                    <Item Key="Title" Translatable="1">Service Catalog</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="CustomerFrontend::Navigation###CustomerCareOnCloudCatalog###001-CareOnCloud" Required="0" Valid="1">
        <Description Translatable="1">CareOnCloud service catalog customer menu registration.</Description>
        <Navigation>Frontend::Customer::ModuleRegistration::MainMenu</Navigation>
        <Value>
            <Array>
                <DefaultItem ValueType="FrontendNavigation"><Hash></Hash></DefaultItem>
                <Item>
                    <Hash>
                        <Item Key="Group"><Array></Array></Item>
                        <Item Key="GroupRo"><Array></Array></Item>
                        <Item Key="Description" Translatable="1">Browse the service catalog.</Item>
                        <Item Key="Name" Translatable="1">Service Catalog</Item>
                        <Item Key="Link">Action=CustomerCareOnCloudCatalog</Item>
                        <Item Key="LinkOption"></Item>
                        <Item Key="NavBar">CareOnCloudCatalog</Item>
                        <Item Key="Type">Menu</Item>
                        <Item Key="Block"></Item>
                        <Item Key="AccessKey">c</Item>
                        <Item Key="Prio">90</Item>
                        <Item Key="svgIcon">var/httpd/htdocs/skins/Customer/default/img/newticket.svg</Item>
                    </Hash>
                </Item>
            </Array>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###AdminCareOnCloudCatalog" Required="0" Valid="1">
        <Description Translatable="1">Tenant-authorized CareOnCloud catalog management module.</Description>
        <Navigation>Frontend::Admin::ModuleRegistration</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group"><Array></Array></Item>
                    <Item Key="GroupRo"><Array></Array></Item>
                    <Item Key="Description" Translatable="1">Manage tenant services, offerings, items, and forms.</Item>
                    <Item Key="Title" Translatable="1">CareOnCloud Service Catalog</Item>
                    <Item Key="NavBarName">Admin</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="Frontend::NavigationModule###AdminCareOnCloudCatalog" Required="0" Valid="1">
        <Description Translatable="1">CareOnCloud tenant catalog navigation in the admin overview.</Description>
        <Navigation>Frontend::Admin::ModuleRegistration::AdminOverview</Navigation>
        <Value>
            <Hash>
                <Item Key="Group"><Array></Array></Item>
                <Item Key="GroupRo"><Array></Array></Item>
                <Item Key="Module">Kernel::Output::HTML::NavBar::ModuleAdmin</Item>
                <Item Key="Name" Translatable="1">CareOnCloud Service Catalog</Item>
                <Item Key="Block">CareOnCloud ESM</Item>
                <Item Key="Description" Translatable="1">Manage tenant-scoped service catalog and dynamic forms.</Item>
                <Item Key="IconBig">fa-sitemap</Item>
                <Item Key="IconSmall"></Item>
            </Hash>
        </Value>
    </Setting>
</careoncloud_config>
