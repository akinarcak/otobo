<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
    <Name>CareOnCloudFoundation</Name>
    <Version>0.2.1</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor>
    <URL>https://esm.arcak.net</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Foundation services, CareOnCloud ESM product identity and diagnostics.</Description>
    <Description Lang="tr">CareOnCloud ESM icin temel servisler, urun kimligi ve tanilama araclari.</Description>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageIsVisible>1</PackageIsVisible>
    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudFoundation.xml" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/Foundation.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/FoundationStatus.pm" />
        <File Permission="644" Location="var/httpd/htdocs/skins/Agent/default/img/careon-logo.png" />
        <File Permission="644" Location="var/httpd/htdocs/skins/Customer/default/img/careon-logo.png" />
        <File Permission="644" Location="var/httpd/htdocs/skins/Customer/default/img/careon-signet.png" />
        <File Permission="644" Location="var/httpd/htdocs/careoncloud/brand/careon-logo.png" />
        <File Permission="644" Location="scripts/test/CareOnCloud/Foundation.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/FoundationStatus.t" />
    </Filelist>
</careoncloud_package>
