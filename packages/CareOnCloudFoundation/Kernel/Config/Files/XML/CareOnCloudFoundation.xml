<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_config version="2.0" init="Application">
    <Setting Name="CareOnCloud::Foundation::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enables the CareOnCloud ESM foundation services.</Description>
        <Navigation>Core::CareOnCloud</Navigation>
        <Value>
            <Item ValueType="Checkbox">1</Item>
        </Value>
    </Setting>
    <Setting Name="CareOnCloud::Foundation::ProductName" Required="1" Valid="1">
        <Description Translatable="1">Defines the CareOnCloud product name shown by platform services.</Description>
        <Navigation>Core::CareOnCloud</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^.{1,80}$">CareOnCloud ESM</Item>
        </Value>
    </Setting>
    <Setting Name="CareOnCloud::Foundation::Slogan" Required="1" Valid="1">
        <Description Translatable="1">Defines the CareOnCloud ESM brand slogan.</Description>
        <Navigation>Core::CareOnCloud</Navigation>
        <Value><Item ValueType="String" ValueRegex="^.{1,120}$">Hizmet Bulutta, Kontrol Sizde.</Item></Value>
    </Setting>
    <Setting Name="CareOnCloud::Foundation::Edition" Required="1" Valid="1">
        <Description Translatable="1">Defines the support and operations edition. All editions remain GPL-3.0.</Description>
        <Navigation>Core::CareOnCloud</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="Community">
                <Item ValueType="Option" Value="Community">Community</Item>
                <Item ValueType="Option" Value="Professional">Professional</Item>
                <Item ValueType="Option" Value="Enterprise">Enterprise</Item>
                <Item ValueType="Option" Value="Managed">Managed</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="CareOnCloud::Foundation::TelemetryEnabled" Required="1" Valid="1">
        <Description Translatable="1">Enables privacy-preserving operational telemetry. Disabled by default.</Description>
        <Navigation>Core::CareOnCloud</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
        </Value>
    </Setting>
</careoncloud_config>
