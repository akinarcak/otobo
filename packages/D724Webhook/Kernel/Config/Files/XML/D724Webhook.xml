<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Application">
    <Setting Name="D724::Webhook::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enables tenant-safe D724 lifecycle webhook subscriptions.</Description>
        <Navigation>Core::D724::Webhook</Navigation><Value><Item ValueType="Checkbox">1</Item></Value>
    </Setting>
    <Setting Name="D724::Webhook::ScanBatchSize" Required="1" Valid="1">
        <Description Translatable="1">Maximum audit events scanned per active subscription and run.</Description>
        <Navigation>Core::D724::Webhook</Navigation><Value><Item ValueType="String" ValueRegex="^(?:[1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$">100</Item></Value>
    </Setting>
    <Setting Name="Daemon::SchedulerCronTaskManager::Task###D724WebhookScan" Required="0" Valid="1">
        <Description Translatable="1">Scan immutable audit events into the shared signed-delivery outbox every minute.</Description>
        <Navigation>Daemon::SchedulerCronTaskManager::Task</Navigation>
        <Value><Hash>
            <Item Key="TaskName">D724WebhookScan</Item><Item Key="Schedule">* * * * *</Item>
            <Item Key="Module">Kernel::System::D724::Webhook</Item><Item Key="Function">Scan</Item>
            <Item Key="MaximumParallelInstances">1</Item><Item Key="Params"><Array></Array></Item>
        </Hash></Value>
    </Setting>
</otobo_config>
