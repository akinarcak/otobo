<careoncloud_package version="1.0"><Name>CareOnCloudChange</Name><Version>0.2.1</Version><Framework>11.1.x</Framework><Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://esm.arcak.net</URL><License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License><Description Lang="en">Tenant-safe Change Enablement and CAB workflow for CareOnCloud ESM.</Description><PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired><PackageRequired Version="0.10.0">CareOnCloudTenantGuard</PackageRequired><PackageRequired Version="0.2.1">CareOnCloudTenantDirectory</PackageRequired><PackageRequired Version="0.2.1">CareOnCloudAudit</PackageRequired><PackageRequired Version="0.4.1">CareOnCloudCMDB</PackageRequired><PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
<DatabaseInstall Type="post"><TableCreate Name="careoncloud_change"><Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="change_number" Required="true" Size="32" Type="VARCHAR"/><Column Name="title" Required="true" Size="250" Type="VARCHAR"/><Column Name="description" Required="true" Size="4000" Type="VARCHAR"/><Column Name="change_type" Required="true" Size="20" Type="VARCHAR"/><Column Name="impact" Required="true" Size="20" Type="VARCHAR"/><Column Name="likelihood" Required="true" Size="20" Type="VARCHAR"/><Column Name="risk_score" Required="true" Type="INTEGER"/><Column Name="risk_level" Required="true" Size="20" Type="VARCHAR"/><Column Name="service_instance_id" Required="false" Type="BIGINT"/><Column Name="implementation_plan" Required="true" Size="4000" Type="VARCHAR"/><Column Name="test_plan" Required="true" Size="4000" Type="VARCHAR"/><Column Name="backout_plan" Required="true" Size="4000" Type="VARCHAR"/><Column Name="planned_start" Required="false" Type="DATE"/><Column Name="planned_end" Required="false" Type="DATE"/><Column Name="status" Required="true" Size="30" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/><Unique Name="careoncloud_change_tenant_number"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="change_number"/></Unique><Unique Name="careoncloud_change_tenant_id"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="id"/></Unique><ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey></TableCreate><TableCreate Name="careoncloud_change_approval"><Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="change_id" Required="true" Type="BIGINT"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="comment" Required="true" Size="2000" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="decision_time" Required="false" Type="DATE"/><Column Name="decision_by" Required="false" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Unique Name="careoncloud_change_approval_tenant_change"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="change_id"/></Unique><ForeignKey ForeignTable="careoncloud_change"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="change_id" Foreign="id"/></ForeignKey></TableCreate></DatabaseInstall><DatabaseUninstall Type="pre"><TableDrop Name="careoncloud_change_approval"/><TableDrop Name="careoncloud_change"/></DatabaseUninstall>
<CodeInstall Type="post"><![CDATA[$Kernel::OM->Get('Kernel::System::CareOnCloud::ChangeConstraint')->Ensure()->{Success} || die "CareOnCloud Change tenant constraint could not be installed";]]></CodeInstall><CodeUpgrade Type="post"><![CDATA[$Kernel::OM->Get('Kernel::System::CareOnCloud::ChangeConstraint')->Ensure()->{Success} || die "CareOnCloud Change tenant constraint could not be upgraded";]]></CodeUpgrade>
