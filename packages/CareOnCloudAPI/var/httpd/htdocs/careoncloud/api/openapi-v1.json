{
  "openapi": "3.1.0",
  "info": {
    "title": "CareOnCloud ESM API",
    "version": "1.0.0",
    "description": "Tenant-isolated integration API for CareOnCloud ESM. GPL-3.0-only server implementation."
  },
  "servers": [{ "url": "/careoncloud/api/v1" }],
  "tags": [
    { "name": "Authentication" },
    { "name": "Tickets" },
    { "name": "Requests" },
    { "name": "Webhooks" }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": ["Authentication"],
        "operationId": "issueToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type", "client_id", "client_secret"],
                "properties": {
                  "grant_type": { "type": "string", "const": "client_credentials" },
                  "client_id": { "type": "string", "minLength": 8, "maxLength": 128 },
                  "client_secret": { "type": "string", "writeOnly": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Opaque bearer token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tickets": {
      "get": {
        "tags": ["Tickets"],
        "operationId": "listTickets",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "after_id", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Tenant-scoped ticket page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketListEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/tickets/{ticket_id}": {
      "get": {
        "tags": ["Tickets"],
        "operationId": "getTicket",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "ticket_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": { "description": "Tenant-scoped ticket", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TicketEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/requests": {
      "post": {
        "tags": ["Requests"],
        "operationId": "createRequest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestCreate" } } }
        },
        "responses": {
          "201": { "description": "Request created", "headers": { "Location": { "schema": { "type": "string" } }, "Idempotent-Replayed": { "schema": { "type": "boolean" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestEnvelope" } } } },
          "200": { "description": "Idempotent replay", "headers": { "Idempotent-Replayed": { "schema": { "type": "boolean", "const": true } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/requests/{request_id}": {
      "get": {
        "tags": ["Requests"],
        "operationId": "getRequest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "request_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "requester_login", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 200 } }
        ],
        "responses": {
          "200": { "description": "Requester-owned request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/requests/{request_id}/approval": {
      "post": {
        "tags": ["Requests"],
        "operationId": "decideRequestApproval",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "request_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalDecision" } } }
        },
        "responses": {
          "200": { "description": "Approval decided or safely replayed", "headers": { "Idempotent-Replayed": { "schema": { "type": "boolean" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/tasks/{task_id}": {
      "patch": {
        "tags": ["Requests"],
        "operationId": "updateRequestTask",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "task_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskTransition" } } }
        },
        "responses": {
          "200": { "description": "Task transitioned or safely replayed", "headers": { "Idempotent-Replayed": { "schema": { "type": "boolean" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/webhook-subscriptions": {
      "get": {
        "tags": ["Webhooks"], "operationId": "listWebhookSubscriptions", "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Tenant webhook subscriptions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionListEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "tags": ["Webhooks"], "operationId": "createWebhookSubscription", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionCreate" } } } },
        "responses": {
          "201": { "description": "Webhook subscription created", "headers": { "Location": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/Unprocessable" }, "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/webhook-subscriptions/{subscription_id}": {
      "get": {
        "tags": ["Webhooks"], "operationId": "getWebhookSubscription", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "subscription_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": { "description": "Tenant webhook subscription", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Webhooks"], "operationId": "updateWebhookSubscription", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "subscription_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionUpdate" } } } },
        "responses": {
          "200": { "description": "Webhook subscription updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionEnvelope" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/Unprocessable" }
        }
      }
    },
    "/openapi.json": {
      "get": { "operationId": "getOpenAPI", "responses": { "200": { "description": "OpenAPI 3.1 document" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Error": { "type": "object", "required": ["success", "error"], "properties": { "success": { "type": "boolean", "const": false }, "error": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } } } },
      "TokenEnvelope": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean", "const": true }, "data": { "type": "object", "required": ["access_token", "token_type", "expires_in", "tenant_id", "role"], "properties": { "access_token": { "type": "string", "writeOnly": true }, "token_type": { "type": "string", "const": "Bearer" }, "expires_in": { "type": "integer" }, "tenant_id": { "type": "string" }, "role": { "type": "string" } } } } },
      "Ticket": { "type": "object", "required": ["id", "number", "title", "tenant_id", "state"], "properties": { "id": { "type": "integer" }, "number": { "type": "string" }, "title": { "type": "string" }, "queue": { "type": "string" }, "state": { "type": "string" }, "priority": { "type": "string" }, "tenant_id": { "type": "string" }, "created_at": { "type": "string" }, "changed_at": { "type": "string" } } },
      "TicketEnvelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Ticket" } } },
      "TicketListEnvelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" } }, "count": { "type": "integer" }, "next_cursor": { "type": ["integer", "null"] } } } } },
      "RequestCreate": { "type": "object", "additionalProperties": false, "required": ["catalog_item_id", "requester_login", "answers"], "properties": { "catalog_item_id": { "type": "integer", "minimum": 1 }, "requester_login": { "type": "string", "maxLength": 200 }, "answers": { "type": "object" } } },
      "ApprovalDecision": { "type": "object", "additionalProperties": false, "required": ["decision", "expected_version"], "properties": { "decision": { "type": "string", "enum": ["approved", "rejected"] }, "expected_version": { "type": "integer", "minimum": 1 }, "comment": { "type": "string", "maxLength": 4000 } } },
      "TaskTransition": { "type": "object", "additionalProperties": false, "required": ["status", "expected_version"], "properties": { "status": { "type": "string", "enum": ["in_progress", "completed", "failed"] }, "expected_version": { "type": "integer", "minimum": 1 }, "comment": { "type": "string", "maxLength": 4000 } } },
      "WebhookSubscriptionCreate": { "type": "object", "additionalProperties": false, "required": ["key", "name", "endpoint_key", "event_patterns"], "properties": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "endpoint_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "event_patterns": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } }, "start_sequence": { "type": "integer", "minimum": 0, "description": "Omit to start at the current tenant audit head. Explicit catch-up cannot exceed the current head." } } },
      "WebhookSubscriptionUpdate": { "type": "object", "additionalProperties": false, "required": ["expected_version"], "properties": { "expected_version": { "type": "integer", "minimum": 1 }, "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "endpoint_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }, "event_patterns": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } }, "status": { "type": "string", "enum": ["active", "inactive"] } } },
      "WebhookSubscription": { "type": "object", "required": ["id", "tenant_id", "key", "name", "endpoint_key", "event_patterns", "status", "cursor_sequence", "version"], "properties": { "id": { "type": "integer" }, "tenant_id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" }, "endpoint_key": { "type": "string" }, "event_patterns": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string" }, "cursor_sequence": { "type": "integer" }, "version": { "type": "integer" }, "created_at": { "type": "string" }, "changed_at": { "type": "string" } } },
      "WebhookSubscriptionEnvelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/WebhookSubscription" } } },
      "WebhookSubscriptionListEnvelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookSubscription" } } } },
      "Request": { "type": "object", "required": ["id", "number", "tenant_id", "catalog_item_id", "status", "version"], "properties": { "id": { "type": "integer" }, "number": { "type": "string" }, "tenant_id": { "type": "string" }, "catalog_item_id": { "type": "integer" }, "status": { "type": "string" }, "version": { "type": "integer" }, "approvals": { "type": "array", "items": { "type": "object" } }, "tasks": { "type": "array", "items": { "type": "object" } }, "created_at": { "type": "string" }, "changed_at": { "type": "string" } } },
      "RequestEnvelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Request" } } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Invalid, expired, or revoked credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "The integration role cannot perform this operation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Object absent or outside the caller scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Idempotency key or optimistic version conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unprocessable": { "description": "The named deployment endpoint is not configured", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "Per-client minute limit exceeded", "headers": { "Retry-After": { "schema": { "type": "integer" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
