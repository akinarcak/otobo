<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_config version="2.0" init="Application">
    <Setting Name="D724::SCIM::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enable tenant-isolated SCIM 2.0 provisioning.</Description>
        <Navigation>Core::D724::SCIM</Navigation><Value><Item ValueType="Checkbox">1</Item></Value>
    </Setting>
    <Setting Name="D724::SCIM::DefaultSurface" Required="1" Valid="1">
        <Description Translatable="1">Default account surface for SCIM users.</Description>
        <Navigation>Core::D724::SCIM</Navigation><Value><Item ValueType="String" ValueRegex="^(agent|customer)$">agent</Item></Value>
    </Setting>
    <Setting Name="D724::SCIM::ListLimitMax" Required="1" Valid="1">
        <Description Translatable="1">Maximum SCIM page size.</Description>
        <Navigation>Core::D724::SCIM</Navigation><Value><Item ValueType="String" ValueRegex="^[1-9][0-9]{0,3}$">200</Item></Value>
    </Setting>
    <Setting Name="PublicFrontend::Module###PublicD724SCIM" Required="0" Valid="1">
        <Description Translatable="1">Public transport endpoint for tenant-isolated SCIM 2.0.</Description>
        <Navigation>Frontend::Public::ModuleRegistration</Navigation>
        <Value><Item ValueType="FrontendRegistration"><Hash>
            <Item Key="Group"><Array></Array></Item><Item Key="GroupRo"><Array></Array></Item>
            <Item Key="Description">CareOnCloud SCIM 2.0 transport</Item><Item Key="Title">CareOnCloud SCIM</Item>
            <Item Key="NavBarName"></Item>
        </Hash></Item></Value>
    </Setting>
</careoncloud_config>
