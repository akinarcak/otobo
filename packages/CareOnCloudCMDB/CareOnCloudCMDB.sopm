<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
 <Name>CareOnCloudCMDB</Name><Version>0.4.1</Version><Framework>11.1.x</Framework>
 <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://esm.arcak.net</URL>
 <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
 <Description Lang="en">Tenant-isolated configuration items and service graph for CareOnCloud ESM.</Description>
 <Description Lang="tr">CareOnCloud ESM icin tenant-izole konfigurasyon ogeleri ve hizmet haritasi.</Description>
 <PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired><PackageRequired Version="0.10.0">CareOnCloudTenantGuard</PackageRequired><PackageRequired Version="0.2.0">CareOnCloudAudit</PackageRequired><PackageRequired Version="0.6.1">CareOnCloudCatalog</PackageRequired>
 <PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
 <CodeInstall Type="post"><![CDATA[$Kernel::OM->Get('Kernel::System::CareOnCloud::CMDBConstraint')->Ensure()->{Success} || die "CareOnCloud CMDB tenant constraints could not be installed";]]></CodeInstall>
 <DatabaseInstall Type="post">
  <TableCreate Name="careoncloud_service_category">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="key_name" Required="true" Size="100" Type="VARCHAR"/><Column Name="name" Required="true" Size="200" Type="VARCHAR"/><Column Name="description" Required="true" Size="4000" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_service_category_tenant_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="key_name"/></Unique><Unique Name="careoncloud_service_category_tenant_id"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="id"/></Unique><ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_service_category_service">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="category_id" Required="true" Type="BIGINT"/><Column Name="service_id" Required="true" Type="BIGINT"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_category_service_unique"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="service_id"/></Unique><ForeignKey ForeignTable="careoncloud_service_category"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="category_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="careoncloud_service"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="service_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_service_instance">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="service_id" Required="true" Type="BIGINT"/><Column Name="key_name" Required="true" Size="100" Type="VARCHAR"/><Column Name="name" Required="true" Size="200" Type="VARCHAR"/><Column Name="description" Required="true" Size="4000" Type="VARCHAR"/><Column Name="support_group_id" Required="false" Type="INTEGER"/><Column Name="service_model" Required="true" Size="30" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="criticality" Required="true" Size="20" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_service_instance_tenant_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="key_name"/></Unique><Unique Name="careoncloud_service_instance_tenant_id"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="id"/></Unique><Index Name="careoncloud_service_instance_service"><IndexColumn Name="tenant_id"/><IndexColumn Name="service_id"/><IndexColumn Name="status"/></Index><ForeignKey ForeignTable="careoncloud_service"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="service_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="groups_table"><Reference Local="support_group_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_ci_type">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="key_name" Required="true" Size="100" Type="VARCHAR"/><Column Name="name" Required="true" Size="200" Type="VARCHAR"/><Column Name="description" Required="true" Size="4000" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="attribute_schema_json" Required="true" Size="16000" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_ci_type_tenant_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="key_name"/></Unique><Unique Name="careoncloud_ci_type_tenant_id"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="id"/></Unique><Index Name="careoncloud_ci_type_tenant_status"><IndexColumn Name="tenant_id"/><IndexColumn Name="status"/></Index><ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_ci">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="type_id" Required="true" Type="BIGINT"/><Column Name="key_name" Required="true" Size="100" Type="VARCHAR"/><Column Name="name" Required="true" Size="200" Type="VARCHAR"/><Column Name="description" Required="true" Size="4000" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="criticality" Required="true" Size="20" Type="VARCHAR"/><Column Name="owner_user_id" Required="false" Type="INTEGER"/><Column Name="attributes_json" Required="true" Size="16000" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_ci_tenant_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="key_name"/></Unique><Unique Name="careoncloud_ci_tenant_id"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="id"/></Unique><Index Name="careoncloud_ci_tenant_status"><IndexColumn Name="tenant_id"/><IndexColumn Name="status"/><IndexColumn Name="type_id"/></Index><ForeignKey ForeignTable="careoncloud_ci_type"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="type_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="owner_user_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_ci_relation">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="source_ci_id" Required="true" Type="BIGINT"/><Column Name="target_ci_id" Required="true" Type="BIGINT"/><Column Name="relation_type" Required="true" Size="30" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_ci_relation_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="source_ci_id"/><UniqueColumn Name="target_ci_id"/><UniqueColumn Name="relation_type"/></Unique><Index Name="careoncloud_ci_relation_target"><IndexColumn Name="tenant_id"/><IndexColumn Name="target_ci_id"/><IndexColumn Name="status"/></Index><ForeignKey ForeignTable="careoncloud_ci"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="source_ci_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="careoncloud_ci"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="target_ci_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
  <TableCreate Name="careoncloud_service_instance_ci">
   <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT"/><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR"/><Column Name="service_instance_id" Required="true" Type="BIGINT"/><Column Name="ci_id" Required="true" Type="BIGINT"/><Column Name="relationship_type" Required="true" Size="30" Type="VARCHAR"/><Column Name="status" Required="true" Size="20" Type="VARCHAR"/><Column Name="version" Required="true" Type="INTEGER"/><Column Name="create_time" Required="true" Type="DATE"/><Column Name="create_by" Required="true" Type="INTEGER"/><Column Name="change_time" Required="true" Type="DATE"/><Column Name="change_by" Required="true" Type="INTEGER"/>
   <Unique Name="careoncloud_instance_ci_key"><UniqueColumn Name="tenant_id"/><UniqueColumn Name="service_instance_id"/><UniqueColumn Name="ci_id"/><UniqueColumn Name="relationship_type"/></Unique><Index Name="careoncloud_instance_ci_ci"><IndexColumn Name="tenant_id"/><IndexColumn Name="ci_id"/><IndexColumn Name="status"/></Index><ForeignKey ForeignTable="careoncloud_service_instance"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="service_instance_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="careoncloud_ci"><Reference Local="tenant_id" Foreign="tenant_id"/><Reference Local="ci_id" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id"/></ForeignKey><ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id"/></ForeignKey>
  </TableCreate>
 </DatabaseInstall>
 <DatabaseUninstall Type="pre"><TableDrop Name="careoncloud_service_instance_ci"/><TableDrop Name="careoncloud_ci_relation"/><TableDrop Name="careoncloud_ci"/><TableDrop Name="careoncloud_ci_type"/><TableDrop Name="careoncloud_service_instance"/><TableDrop Name="careoncloud_service_category_service"/><TableDrop Name="careoncloud_service_category"/></DatabaseUninstall>
 <Filelist><File Permission="644" Location="Kernel/Language/tr_CareOnCloudCMDB.pm"/><File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudCMDB.xml"/><File Permission="644" Location="Kernel/System/CareOnCloud/CMDB.pm"/><File Permission="644" Location="Kernel/System/CareOnCloud/CMDBConstraint.pm"/><File Permission="644" Location="Kernel/System/CareOnCloud/CMDBWorkbook.pm"/><File Permission="644" Location="Kernel/System/CareOnCloud/CMDBWorkbookImport.pm"/><File Permission="644" Location="Kernel/Modules/AgentCareOnCloudServicePortfolio.pm"/><File Permission="644" Location="Kernel/Output/HTML/Templates/Standard/AgentCareOnCloudServicePortfolio.tt"/><File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/CMDBStatus.pm"/><File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/CMDBWorkbookInspect.pm"/><File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/CMDBWorkbookImport.pm"/><File Permission="644" Location="scripts/test/CareOnCloud/CMDB.t"/><File Permission="644" Location="scripts/test/CareOnCloud/CMDBConstraint.t"/><File Permission="644" Location="scripts/test/CareOnCloud/CMDBWorkbook.t"/><File Permission="644" Location="scripts/test/CareOnCloud/CMDBFrontend.t"/></Filelist>
</careoncloud_package>
