        <File Permission="644" Location="Kernel/System/Console/Command/Admin/D724/FoundationStatus.pm" />
        <File Permission="644" Location="scripts/test/D724/Foundation.t" />
        <File Permission="644" Location="scripts/test/D724/FoundationStatus.t" />
    </Filelist>
</otobo_package>
