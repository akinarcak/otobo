    <Description Lang="en">Foundation services, product identity and diagnostics for D724 ESM.</Description>
    <Description Lang="tr">D724 ESM icin temel servisler, urun kimligi ve tanilama araclari.</Description>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageIsVisible>1</PackageIsVisible>
    <Filelist>
