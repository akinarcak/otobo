<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
    <Name>CareOnCloudCommitment</Name><Version>0.5.0</Version><Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://esm.arcak.net</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Tenant-safe business-time commitments, pause rules, breach evaluation, and escalation evidence for CareOnCloud ESM.</Description>
    <Description Lang="tr">CareOnCloud ESM icin tenant guvenli is zamani taahhutleri, duraklatma, ihlal ve eskalasyon kaniti.</Description>
    <PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired>
    <PackageRequired Version="0.3.0">CareOnCloudTenantGuard</PackageRequired>
    <PackageRequired Version="0.2.1">CareOnCloudTenantDirectory</PackageRequired>
    <PackageRequired Version="0.2.0">CareOnCloudAudit</PackageRequired>
    <PackageRequired Version="0.4.7">CareOnCloudRequest</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
    <DatabaseInstall Type="post">
        <TableCreate Name="careoncloud_commitment_policy">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="key_name" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="name" Required="true" Size="200" Type="VARCHAR" /><Column Name="calendar_id" Required="true" Type="INTEGER" />
            <Column Name="target_seconds" Required="true" Type="BIGINT" /><Column Name="warning_percent" Required="true" Type="INTEGER" />
            <Column Name="pause_statuses_json" Required="true" Size="4000" Type="VARCHAR" /><Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="version" Required="true" Type="INTEGER" /><Column Name="create_time" Required="true" Type="DATE" /><Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" /><Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique Name="careoncloud_commitment_policy_key"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="key_name" /></Unique>
            <Unique Name="careoncloud_commitment_policy_tenant_id"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="id" /></Unique>
        </TableCreate>
        <TableCreate Name="careoncloud_commitment_instance">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="request_id" Required="true" Type="BIGINT" />
            <Column Name="policy_id" Required="true" Type="BIGINT" /><Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="objective_key" Required="true" Size="64" Type="VARCHAR" /><Column Name="objective_type" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="start_signal" Required="true" Size="30" Type="VARCHAR" /><Column Name="stop_signal" Required="true" Size="30" Type="VARCHAR" />
            <Column Name="escalation_actions_json" Required="true" Size="8000" Type="VARCHAR" />
            <Column Name="target_seconds" Required="true" Type="BIGINT" /><Column Name="consumed_seconds" Required="true" Type="BIGINT" />
            <Column Name="calendar_id" Required="true" Type="INTEGER" /><Column Name="warning_percent" Required="true" Type="INTEGER" />
            <Column Name="start_time" Required="true" Type="DATE" /><Column Name="running_since" Required="false" Type="DATE" />
            <Column Name="paused_at" Required="false" Type="DATE" /><Column Name="warning_time" Required="true" Type="DATE" />
            <Column Name="due_time" Required="true" Type="DATE" /><Column Name="breached_at" Required="false" Type="DATE" />
            <Column Name="met_at" Required="false" Type="DATE" /><Column Name="version" Required="true" Type="INTEGER" />
            <Column Name="create_time" Required="true" Type="DATE" /><Column Name="create_by" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="change_time" Required="true" Type="DATE" /><Column Name="change_by" Required="true" Size="128" Type="VARCHAR" />
            <Unique Name="careoncloud_commitment_request_objective"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="request_id" /><UniqueColumn Name="objective_key" /></Unique>
            <Unique Name="careoncloud_commitment_instance_tenant_id"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="id" /></Unique>
            <Index Name="careoncloud_commitment_due"><IndexColumn Name="tenant_id" /><IndexColumn Name="status" /><IndexColumn Name="due_time" /></Index>
        </TableCreate>
        <TableCreate Name="careoncloud_commitment_objective">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="policy_id" Required="true" Type="BIGINT" />
            <Column Name="key_name" Required="true" Size="64" Type="VARCHAR" /><Column Name="objective_type" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="target_seconds" Required="true" Type="BIGINT" /><Column Name="warning_percent" Required="true" Type="INTEGER" />
            <Column Name="start_signal" Required="true" Size="30" Type="VARCHAR" /><Column Name="stop_signal" Required="true" Size="30" Type="VARCHAR" />
            <Column Name="escalation_actions_json" Required="true" Size="8000" Type="VARCHAR" /><Column Name="sequence_no" Required="true" Type="INTEGER" />
            <Unique Name="careoncloud_policy_objective_key"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="policy_id" /><UniqueColumn Name="key_name" /></Unique>
        </TableCreate>
        <TableCreate Name="careoncloud_commitment_event">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="commitment_id" Required="true" Type="BIGINT" />
            <Column Name="event_type" Required="true" Size="30" Type="VARCHAR" /><Column Name="event_time" Required="true" Type="DATE" />
            <Column Name="from_status" Required="true" Size="20" Type="VARCHAR" /><Column Name="to_status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="consumed_seconds" Required="true" Type="BIGINT" /><Column Name="actor" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="reason" Required="true" Size="1000" Type="VARCHAR" /><Column Name="create_time" Required="true" Type="DATE" />
            <Index Name="careoncloud_commitment_event_scope"><IndexColumn Name="tenant_id" /><IndexColumn Name="commitment_id" /><IndexColumn Name="id" /></Index>
        </TableCreate>
        <TableCreate Name="careoncloud_escalation_outbox">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="commitment_id" Required="true" Type="BIGINT" />
            <Column Name="commitment_event_id" Required="true" Type="BIGINT" /><Column Name="action_key" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="action_type" Required="true" Size="30" Type="VARCHAR" /><Column Name="payload_json" Required="true" Size="8000" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" /><Column Name="attempt_count" Required="true" Type="INTEGER" />
            <Column Name="lifetime_attempt_count" Required="true" Default="0" Type="INTEGER" /><Column Name="replay_count" Required="true" Default="0" Type="INTEGER" />
            <Column Name="available_time" Required="true" Type="DATE" /><Column Name="processed_time" Required="false" Type="DATE" />
            <Column Name="lease_token" Required="true" Default="" Size="64" Type="VARCHAR" /><Column Name="lease_until" Required="false" Type="DATE" />
            <Column Name="delivery_ref" Required="true" Default="" Size="255" Type="VARCHAR" /><Column Name="response_code" Required="true" Default="" Size="64" Type="VARCHAR" />
            <Column Name="last_error" Required="true" Size="2000" Type="VARCHAR" /><Column Name="create_time" Required="true" Type="DATE" />
            <Column Name="change_time" Required="true" Type="DATE" />
            <Unique Name="careoncloud_escalation_action_once"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="commitment_event_id" /><UniqueColumn Name="action_key" /></Unique>
            <Index Name="careoncloud_escalation_dispatch"><IndexColumn Name="status" /><IndexColumn Name="available_time" /><IndexColumn Name="id" /></Index>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUpgrade Type="post">
        <TableAlter Name="careoncloud_commitment_instance" Version="0.2.0">
            <UniqueDrop Name="careoncloud_commitment_request" />
            <ColumnAdd Name="objective_key" Required="true" Default="resolution" Size="64" Type="VARCHAR" />
            <ColumnAdd Name="objective_type" Required="true" Default="resolution" Size="20" Type="VARCHAR" />
            <ColumnAdd Name="start_signal" Required="true" Default="request_created" Size="30" Type="VARCHAR" />
            <ColumnAdd Name="stop_signal" Required="true" Default="request_fulfilled" Size="30" Type="VARCHAR" />
            <ColumnAdd Name="escalation_actions_json" Required="true" Default="[]" Size="8000" Type="VARCHAR" />
            <UniqueCreate Name="careoncloud_commitment_request_objective"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="request_id" /><UniqueColumn Name="objective_key" /></UniqueCreate>
        </TableAlter>
        <TableCreate Name="careoncloud_commitment_objective" Version="0.2.1">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="policy_id" Required="true" Type="BIGINT" />
            <Column Name="key_name" Required="true" Size="64" Type="VARCHAR" /><Column Name="objective_type" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="target_seconds" Required="true" Type="BIGINT" /><Column Name="warning_percent" Required="true" Type="INTEGER" />
            <Column Name="start_signal" Required="true" Size="30" Type="VARCHAR" /><Column Name="stop_signal" Required="true" Size="30" Type="VARCHAR" />
            <Column Name="escalation_actions_json" Required="true" Size="8000" Type="VARCHAR" /><Column Name="sequence_no" Required="true" Type="INTEGER" />
            <Unique Name="careoncloud_policy_objective_key"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="policy_id" /><UniqueColumn Name="key_name" /></Unique>
        </TableCreate>
        <TableCreate Name="careoncloud_escalation_outbox" Version="0.2.0">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="commitment_id" Required="true" Type="BIGINT" />
            <Column Name="commitment_event_id" Required="true" Type="BIGINT" /><Column Name="action_key" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="action_type" Required="true" Size="30" Type="VARCHAR" /><Column Name="payload_json" Required="true" Size="8000" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" /><Column Name="attempt_count" Required="true" Type="INTEGER" />
            <Column Name="available_time" Required="true" Type="DATE" /><Column Name="processed_time" Required="false" Type="DATE" />
            <Column Name="last_error" Required="true" Size="2000" Type="VARCHAR" /><Column Name="create_time" Required="true" Type="DATE" /><Column Name="change_time" Required="true" Type="DATE" />
            <Unique Name="careoncloud_escalation_action_once"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="commitment_event_id" /><UniqueColumn Name="action_key" /></Unique>
            <Index Name="careoncloud_escalation_dispatch"><IndexColumn Name="status" /><IndexColumn Name="available_time" /><IndexColumn Name="id" /></Index>
        </TableCreate>
        <TableAlter Name="careoncloud_escalation_outbox" Version="0.3.0">
            <ColumnAdd Name="lease_token" Required="true" Default="" Size="64" Type="VARCHAR" /><ColumnAdd Name="lease_until" Required="false" Type="DATE" />
            <ColumnAdd Name="delivery_ref" Required="true" Default="" Size="255" Type="VARCHAR" /><ColumnAdd Name="response_code" Required="true" Default="" Size="64" Type="VARCHAR" />
        </TableAlter>
        <TableAlter Name="careoncloud_escalation_outbox" Version="0.4.0">
            <ColumnAdd Name="lifetime_attempt_count" Required="true" Default="0" Type="INTEGER" />
            <ColumnAdd Name="replay_count" Required="true" Default="0" Type="INTEGER" />
        </TableAlter>
    </DatabaseUpgrade>
    <DatabaseUninstall Type="pre"><TableDrop Name="careoncloud_escalation_outbox" /><TableDrop Name="careoncloud_commitment_event" /><TableDrop Name="careoncloud_commitment_instance" /><TableDrop Name="careoncloud_commitment_objective" /><TableDrop Name="careoncloud_commitment_policy" /></DatabaseUninstall>
    <Filelist>
        <File Permission="644" Location="Kernel/Language/tr_CareOnCloudCommitment.pm" />
        <File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudCommitment.xml" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/Commitment.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/EscalationDispatcher.pm" />
        <File Permission="644" Location="Kernel/Modules/AdminCareOnCloudCommitment.pm" />
        <File Permission="644" Location="Kernel/Output/HTML/Templates/Standard/AdminCareOnCloudCommitment.tt" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/CommitmentStatus.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/CommitmentReplay.pm" />
        <File Permission="644" Location="scripts/test/CareOnCloud/Commitment.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/CommitmentStatus.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/CommitmentFrontend.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/WebUserAgentRaw.t" />
    </Filelist>
</careoncloud_package>
