<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
    <Name>CareOnCloudWebhook</Name><Version>0.3.0</Version><Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://esm.arcak.net</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Tenant-safe lifecycle webhook subscriptions backed by the immutable CareOnCloud audit chain.</Description>
    <Description Lang="tr">Immutable CareOnCloud audit zincirini kullanan tenant-guvenli lifecycle webhook abonelikleri.</Description>
    <PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired>
    <PackageRequired Version="0.3.0">CareOnCloudTenantGuard</PackageRequired>
    <PackageRequired Version="0.2.1">CareOnCloudTenantDirectory</PackageRequired>
    <PackageRequired Version="0.2.0">CareOnCloudAudit</PackageRequired>
    <PackageRequired Version="0.5.0">CareOnCloudCommitment</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
    <DatabaseInstall Type="post">
        <TableCreate Name="careoncloud_webhook_subscription">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="key_name" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="name" Required="true" Size="200" Type="VARCHAR" />
            <Column Name="endpoint_key" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="event_patterns_json" Required="true" Size="4000" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="cursor_sequence" Required="true" Default="0" Type="BIGINT" />
            <Column Name="version" Required="true" Default="1" Type="INTEGER" />
            <Column Name="create_time" Required="true" Type="DATE" /><Column Name="create_by" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="change_time" Required="true" Type="DATE" /><Column Name="change_by" Required="true" Size="128" Type="VARCHAR" />
            <Unique Name="careoncloud_webhook_subscription_key"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="key_name" /></Unique>
            <Unique Name="careoncloud_webhook_subscription_tenant_id"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="id" /></Unique>
            <Index Name="careoncloud_webhook_subscription_scan"><IndexColumn Name="status" /><IndexColumn Name="tenant_id" /><IndexColumn Name="id" /></Index>
            <ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre"><TableDrop Name="careoncloud_webhook_subscription" /></DatabaseUninstall>
    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudWebhook.xml" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/Webhook.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/WebhookStatus.pm" />
        <File Permission="644" Location="scripts/test/CareOnCloud/Webhook.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/WebhookStatus.t" />
    </Filelist>
</careoncloud_package>
