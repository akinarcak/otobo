<div id="oooContent" class="MainBox ARIARole MainContent">
  <div id="oooHeader"><h1>[% Translate("Service Request") | html %]</h1></div>
  <div id="oooMainBox" class="WidgetSimple"><div class="Content">
[% IF Data.Error %]
    <p class="Error">[% Translate("Request could not be processed") | html %]: [% Data.Error | html %]</p>
[% ELSE %]
    <h2>[% Data.Request.RequestNumber | html %]</h2>
    <p>[% Translate("Status") | html %]: <strong>[% Data.Request.Status | html %]</strong></p>
[% FOREACH Commitment IN Data.Request.Commitments %]
    <p><strong>[% Commitment.ObjectiveType | html %] / [% Commitment.ObjectiveKey | html %]: [% Commitment.Status | html %]</strong></p>
    <p>[% Translate("Warning") | html %]: [% Commitment.WarningTime | html %] — [% Translate("Due") | html %]: [% Commitment.DueTime | html %]</p>
[% END %]
    <p>[% Translate("Your request was recorded safely. Repeating the same submission will not create a duplicate.") | html %]</p>
[% END %]
    <p><a href="[% Env("Baselink") %]Action=CustomerCareOnCloudCatalog">[% Translate("Back to service catalog") | html %]</a></p>
  </div></div>
</div>
