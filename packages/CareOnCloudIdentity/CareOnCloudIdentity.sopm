<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
    <Name>CareOnCloudIdentity</Name><Version>0.3.0</Version><Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://esm.arcak.net</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Tenant-safe federated identity trust boundary for CareOnCloud ESM.</Description>
    <Description Lang="tr">CareOnCloud ESM için tenant güvenli birleşik kimlik güven sınırı.</Description>
    <PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired>
    <PackageRequired Version="0.8.0">CareOnCloudTenantGuard</PackageRequired>
    <PackageRequired Version="0.2.1">CareOnCloudTenantDirectory</PackageRequired>
    <PackageRequired Version="0.2.0">CareOnCloudAudit</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
    <DatabaseInstall Type="post">
        <TableCreate Name="careoncloud_identity_provider">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="key_name" Required="true" Size="100" Type="VARCHAR" />
            <Column Name="issuer" Required="true" Size="500" Type="VARCHAR" />
            <Column Name="audience" Required="true" Size="200" Type="VARCHAR" />
            <Column Name="allowed_domains_json" Required="true" Size="4000" Type="VARCHAR" />
            <Column Name="group_role_map_json" Required="true" Size="8000" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="version" Required="true" Default="1" Type="INTEGER" />
            <Column Name="create_time" Required="true" Type="DATE" /><Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" /><Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique Name="careoncloud_idp_tenant_key"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="key_name" /></Unique>
            <Unique Name="careoncloud_idp_trust_route"><UniqueColumn Name="issuer" /><UniqueColumn Name="audience" /></Unique>
            <ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id" /></ForeignKey>
        </TableCreate>
        <TableCreate Name="careoncloud_federated_identity">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="provider_id" Required="true" Type="BIGINT" />
            <Column Name="subject_id" Required="true" Size="255" Type="VARCHAR" />
            <Column Name="user_login" Required="true" Size="200" Type="VARCHAR" />
            <Column Name="email" Required="true" Size="320" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="version" Required="true" Default="1" Type="INTEGER" />
            <Column Name="last_seen" Required="true" Type="DATE" />
            <Column Name="create_time" Required="true" Type="DATE" /><Column Name="change_time" Required="true" Type="DATE" />
            <Unique Name="careoncloud_identity_subject"><UniqueColumn Name="provider_id" /><UniqueColumn Name="subject_id" /></Unique>
            <Unique Name="careoncloud_identity_login"><UniqueColumn Name="tenant_id" /><UniqueColumn Name="user_login" /></Unique>
            <ForeignKey ForeignTable="careoncloud_identity_provider"><Reference Local="provider_id" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
        </TableCreate>
        <TableCreate Name="careoncloud_oidc_flow">
            <Column Name="state_digest" Required="true" PrimaryKey="true" Size="64" Type="VARCHAR" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="provider_id" Required="true" Type="BIGINT" />
            <Column Name="browser_digest" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="nonce_digest" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="verifier_digest" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="return_path" Required="true" Size="1100" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="expires_at" Required="true" Type="DATE" /><Column Name="create_time" Required="true" Type="DATE" /><Column Name="change_time" Required="true" Type="DATE" />
            <Index Name="careoncloud_oidc_flow_expiry"><IndexColumn Name="status" /><IndexColumn Name="expires_at" /></Index>
            <ForeignKey ForeignTable="careoncloud_identity_provider"><Reference Local="provider_id" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUpgrade Type="post">
        <TableCreate Name="careoncloud_oidc_flow" Version="0.2.0">
            <Column Name="state_digest" Required="true" PrimaryKey="true" Size="64" Type="VARCHAR" /><Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" /><Column Name="provider_id" Required="true" Type="BIGINT" />
            <Column Name="browser_digest" Required="true" Size="64" Type="VARCHAR" /><Column Name="nonce_digest" Required="true" Size="64" Type="VARCHAR" /><Column Name="verifier_digest" Required="true" Size="64" Type="VARCHAR" />
            <Column Name="return_path" Required="true" Size="1100" Type="VARCHAR" /><Column Name="status" Required="true" Size="20" Type="VARCHAR" /><Column Name="expires_at" Required="true" Type="DATE" /><Column Name="create_time" Required="true" Type="DATE" /><Column Name="change_time" Required="true" Type="DATE" />
            <Index Name="careoncloud_oidc_flow_expiry"><IndexColumn Name="status" /><IndexColumn Name="expires_at" /></Index>
            <ForeignKey ForeignTable="careoncloud_identity_provider"><Reference Local="provider_id" Foreign="id" /></ForeignKey><ForeignKey ForeignTable="careoncloud_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
        </TableCreate>
    </DatabaseUpgrade>
    <DatabaseUninstall Type="pre"><TableDrop Name="careoncloud_oidc_flow" /><TableDrop Name="careoncloud_federated_identity" /><TableDrop Name="careoncloud_identity_provider" /></DatabaseUninstall>
    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudIdentity.xml" />
        <File Permission="644" Location="Kernel/Config/Files/CareOnCloudIdentityAuth.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/Identity.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/OIDCFlow.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/OIDCWeb.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/OIDCAuthBackend.pm" />
        <File Permission="644" Location="Kernel/System/Auth/CareOnCloudOpenIDConnect.pm" />
        <File Permission="644" Location="Kernel/System/CustomerAuth/CareOnCloudOpenIDConnect.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/IdentityStatus.pm" />
        <File Permission="644" Location="scripts/test/CareOnCloud/Identity.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/IdentityStatus.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/IdentityTransaction.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/OIDCFlow.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/OIDCWeb.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/OIDCAuthBackend.t" />
    </Filelist>
</careoncloud_package>
