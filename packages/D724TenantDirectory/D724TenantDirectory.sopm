<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>D724TenantDirectory</Name>
    <Version>0.1.0</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor>
    <URL>https://github.com/akinarcak/otobo</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Persistent tenant and tenant-bound agent role directory for D724 ESM.</Description>
    <Description Lang="tr">D724 ESM icin kalici tenant ve tenant-bazli agent rol dizini.</Description>
    <PackageRequired Version="0.1.0">D724Foundation</PackageRequired>
    <PackageRequired Version="0.2.0">D724TenantGuard</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageIsVisible>1</PackageIsVisible>
    <DatabaseInstall Type="post">
        <TableCreate Name="d724_tenant">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="key_name" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="name" Required="true" Size="200" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="version" Required="true" Type="INTEGER" />
            <Column Name="create_time" Required="true" Type="DATE" />
            <Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" />
            <Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique Name="d724_tenant_key"><UniqueColumn Name="key_name" /></Unique>
            <Index Name="d724_tenant_status"><IndexColumn Name="status" /></Index>
            <ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id" /></ForeignKey>
        </TableCreate>
        <TableCreate Name="d724_tenant_agent_role">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="BIGINT" />
            <Column Name="tenant_id" Required="true" Size="128" Type="VARCHAR" />
            <Column Name="user_id" Required="true" Type="INTEGER" />
            <Column Name="role_name" Required="true" Size="30" Type="VARCHAR" />
            <Column Name="status" Required="true" Size="20" Type="VARCHAR" />
            <Column Name="create_time" Required="true" Type="DATE" />
            <Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" />
            <Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique Name="d724_tenant_agent_role_key">
                <UniqueColumn Name="tenant_id" /><UniqueColumn Name="user_id" /><UniqueColumn Name="role_name" />
            </Unique>
            <Index Name="d724_tenant_agent_active"><IndexColumn Name="user_id" /><IndexColumn Name="status" /></Index>
            <ForeignKey ForeignTable="d724_tenant"><Reference Local="tenant_id" Foreign="key_name" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="user_id" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="create_by" Foreign="id" /></ForeignKey>
            <ForeignKey ForeignTable="users"><Reference Local="change_by" Foreign="id" /></ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Name="d724_tenant_agent_role" />
        <TableDrop Name="d724_tenant" />
    </DatabaseUninstall>
    <Filelist>
        <File Permission="644" Location="Kernel/System/D724/TenantDirectory.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/D724/TenantDirectoryStatus.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/D724/TenantBootstrap.pm" />
        <File Permission="644" Location="scripts/test/D724/TenantDirectory.t" />
        <File Permission="644" Location="scripts/test/D724/TenantDirectoryStatus.t" />
    </Filelist>
</otobo_package>
