<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>D724Observability</Name><Version>0.1.0</Version><Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor><URL>https://github.com/akinarcak/otobo</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Authenticated, bounded-cardinality Prometheus health metrics for D724 ESM.</Description>
    <Description Lang="tr">D724 ESM icin kimlik dogrulamali ve sinirli kardinaliteli Prometheus saglik metrikleri.</Description>
    <PackageRequired Version="0.1.0">D724Foundation</PackageRequired>
    <PackageRequired Version="0.6.0">D724TenantGuard</PackageRequired>
    <PackageRequired Version="0.7.1">D724API</PackageRequired>
    <PackageRequired Version="0.5.0">D724Commitment</PackageRequired>
    <PackageRequired Version="0.3.0">D724Webhook</PackageRequired>
    <PackageRequired Version="0.7.1">D724TicketAudit</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable><PackageIsVisible>1</PackageIsVisible>
    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/D724Observability.xml" />
        <File Permission="644" Location="Kernel/System/D724/Observability.pm" />
        <File Permission="644" Location="Kernel/Modules/PublicD724Metrics.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/D724/ObservabilityStatus.pm" />
        <File Permission="644" Location="scripts/test/D724/Observability.t" />
        <File Permission="644" Location="scripts/test/D724/ObservabilityTransport.t" />
    </Filelist>
</otobo_package>
