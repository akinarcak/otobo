<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Application">
    <Setting Name="D724::Observability::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enable the authenticated D724 Prometheus metrics endpoint.</Description>
        <Navigation>Core::D724::Observability</Navigation><Value><Item ValueType="Checkbox">1</Item></Value>
    </Setting>
    <Setting Name="D724::Observability::MetricsTokenSHA256" Required="0" Valid="1">
        <Description Translatable="1">Lowercase SHA-256 digest of the metrics bearer token. An empty value disables HTTP scraping.</Description>
        <Navigation>Core::D724::Observability</Navigation><Value><Item ValueType="String" ValueRegex="^(?:[0-9a-f]{64})?$"></Item></Value>
    </Setting>
    <Setting Name="PublicFrontend::Module###PublicD724Metrics" Required="0" Valid="1">
        <Description Translatable="1">Authenticated D724 Prometheus metrics endpoint.</Description>
        <Navigation>Frontend::Public::ModuleRegistration</Navigation>
        <Value><Item ValueType="FrontendRegistration"><Hash>
            <Item Key="Group"><Array></Array></Item><Item Key="GroupRo"><Array></Array></Item>
            <Item Key="Description">D724 Prometheus metrics</Item><Item Key="Title">D724 Metrics</Item>
            <Item Key="NavBarName"></Item>
        </Hash></Item></Value>
    </Setting>
</otobo_config>
