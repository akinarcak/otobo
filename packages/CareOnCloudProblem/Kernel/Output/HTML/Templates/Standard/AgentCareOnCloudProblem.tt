<div class="MainBox ARIARoleMain"><h1>[% Translate("CareOnCloud Problem Management") | html %]</h1>
<div class="WidgetSimple"><div class="Header"><h2>[% Translate("Problem portfolio") | html %]</h2></div><div class="Content"><form action="[% Env("CGIHandle") %]" method="get"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><label for="TenantID">[% Translate("Customer") | html %]</label><select id="TenantID" name="TenantID" onchange="this.form.submit()">[% RenderBlockStart("TenantOption") %]<option value="[% Data.TenantID | html %]" [% Data.Selected | html %]>[% Data.TenantID | html %]</option>[% RenderBlockEnd("TenantOption") %]</select></form><p><strong>[% Data.Total | html %]</strong> [% Translate("problems") | html %] &middot; [% Data.Investigating | html %] [% Translate("investigating") | html %] &middot; [% Data.KnownErrors | html %] [% Translate("known errors") | html %] &middot; [% Data.Resolved | html %] [% Translate("resolved") | html %]</p></div></div>
<div class="WidgetSimple"><div class="Header"><h2>[% Translate("Register problem") | html %]</h2></div><div class="Content"><form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Create"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><fieldset class="TableLike"><label>[% Translate("Title") | html %]</label><input name="Title" maxlength="250" required/><label>[% Translate("Category") | html %]</label><select name="Category"><option>application</option><option>infrastructure</option><option>network</option><option>security</option><option>supplier</option><option>process</option><option>capacity</option><option>availability</option></select><label>[% Translate("Impact") | html %]</label><select name="Impact"><option>low</option><option selected>medium</option><option>high</option><option>critical</option></select><label>[% Translate("Urgency") | html %]</label><select name="Urgency"><option>low</option><option selected>medium</option><option>high</option><option>critical</option></select><label>[% Translate("Symptom") | html %]</label><textarea name="Symptom" maxlength="4000" required></textarea><label>[% Translate("Business impact") | html %]</label><textarea name="BusinessImpact" maxlength="4000" required></textarea></fieldset><button class="Primary" type="submit">[% Translate("Register problem") | html %]</button></form></div></div>
<div class="WidgetSimple"><div class="Header"><h2>[% Translate("RCA and known-error workbench") | html %]</h2></div><div class="Content"><table class="DataTable"><thead><tr><th>[% Translate("Problem") | html %]</th><th>[% Translate("Priority") | html %]</th><th>[% Translate("Status") | html %]</th><th>[% Translate("Knowledge") | html %]</th><th>[% Translate("Actions") | html %]</th></tr></thead><tbody>
[% RenderBlockStart("ProblemRow") %]<tr><td><strong>[% Data.ProblemNumber | html %]</strong><br/>[% Data.Title | html %]<br/><span class="Description">[% Data.Category | html %] &middot; [% Data.CreateTime | html %]</span></td><td><strong>P[% Data.Priority | html %]</strong><br/>[% Data.Impact | html %] &times; [% Data.Urgency | html %]</td><td>[% Data.Status | html %]<br/>v[% Data.Version | html %]</td><td><details><summary>[% Translate("RCA details") | html %]</summary><p><strong>[% Translate("Symptom") | html %]:</strong> [% Data.Symptom | html %]</p><p><strong>[% Translate("Root cause") | html %]:</strong> [% Data.RootCause | html %]</p><p><strong>[% Translate("Workaround") | html %]:</strong> [% Data.Workaround | html %]</p><p><strong>[% Translate("Permanent fix") | html %]:</strong> [% Data.PermanentFix | html %]</p></details></td><td>
[% RenderBlockStart("StartAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Start"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button type="submit">[% Translate("Start investigation") | html %]</button></form>[% RenderBlockEnd("StartAction") %]
[% RenderBlockStart("DiagnosisAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Diagnose"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><textarea name="RootCause" maxlength="4000" placeholder="[% Translate("Root cause") | html %]">[% Data.RootCause | html %]</textarea><textarea name="Workaround" maxlength="4000" placeholder="[% Translate("Workaround") | html %]">[% Data.Workaround | html %]</textarea><button type="submit">[% Translate("Save RCA") | html %]</button></form>[% RenderBlockEnd("DiagnosisAction") %]
[% RenderBlockStart("KnownErrorAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="KnownError"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button type="submit">[% Translate("Publish known error") | html %]</button></form>[% RenderBlockEnd("KnownErrorAction") %]
[% RenderBlockStart("ResolveAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Resolve"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><textarea name="PermanentFix" maxlength="4000" placeholder="[% Translate("Permanent fix") | html %]">[% Data.PermanentFix | html %]</textarea><button type="submit">[% Translate("Resolve") | html %]</button></form>[% RenderBlockEnd("ResolveAction") %]
[% RenderBlockStart("CloseAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Close"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button type="submit">[% Translate("Close") | html %]</button></form>[% RenderBlockEnd("CloseAction") %]
[% RenderBlockStart("ReopenAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentCareOnCloudProblem"/><input type="hidden" name="Subaction" value="Reopen"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ProblemID" value="[% Data.ProblemID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button type="submit">[% Translate("Reopen") | html %]</button></form>[% RenderBlockEnd("ReopenAction") %]
</td></tr>[% RenderBlockEnd("ProblemRow") %]</tbody></table></div></div></div>
