<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_config version="2.0" init="Application">
    <Setting Name="CareOnCloud::Observability::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enable the authenticated CareOnCloud Prometheus metrics endpoint.</Description>
        <Navigation>Core::CareOnCloud::Observability</Navigation><Value><Item ValueType="Checkbox">1</Item></Value>
    </Setting>
    <Setting Name="CareOnCloud::Observability::MetricsTokenSHA256" Required="0" Valid="1">
        <Description Translatable="1">Lowercase SHA-256 digest of the metrics bearer token. An empty value disables HTTP scraping.</Description>
        <Navigation>Core::CareOnCloud::Observability</Navigation><Value><Item ValueType="String" ValueRegex="^(?:[0-9a-f]{64})?$"></Item></Value>
    </Setting>
    <Setting Name="PublicFrontend::Module###PublicCareOnCloudMetrics" Required="0" Valid="1">
        <Description Translatable="1">Authenticated CareOnCloud Prometheus metrics endpoint.</Description>
        <Navigation>Frontend::Public::ModuleRegistration</Navigation>
        <Value><Item ValueType="FrontendRegistration"><Hash>
            <Item Key="Group"><Array></Array></Item><Item Key="GroupRo"><Array></Array></Item>
            <Item Key="Description">CareOnCloud Prometheus metrics</Item><Item Key="Title">CareOnCloud Metrics</Item>
            <Item Key="NavBarName"></Item>
        </Hash></Item></Value>
    </Setting>
</careoncloud_config>
