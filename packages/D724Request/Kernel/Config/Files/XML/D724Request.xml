<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Application">
    <Setting Name="D724::Request::Enabled" Required="1" Valid="1">
        <Description Translatable="1">Enables tenant-safe D724 request orchestration.</Description><Navigation>Core::D724::Request</Navigation>
        <Value><Item ValueType="Checkbox">1</Item></Value>
    </Setting>
    <Setting Name="D724::Request::ListLimit" Required="1" Valid="1">
        <Description Translatable="1">Maximum requests returned by list operations.</Description><Navigation>Core::D724::Request</Navigation>
        <Value><Item ValueType="String" ValueRegex="^(?:[1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$">200</Item></Value>
    </Setting>
</otobo_config>
