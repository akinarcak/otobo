<div class="MainBox ARIARoleMain">
 <h1>[% Translate("CareOnCloud Change Enablement") | html %]</h1>
 <div class="WidgetSimple"><div class="Header"><h2>[% Translate("Change portfolio") | html %]</h2></div><div class="Content">
  <form action="[% Env("CGIHandle") %]" method="get"><input type="hidden" name="Action" value="AgentD724Change"/><label for="TenantID">[% Translate("Customer") | html %]</label><select id="TenantID" name="TenantID" onchange="this.form.submit()">[% RenderBlockStart("TenantOption") %]<option value="[% Data.TenantID | html %]" [% Data.Selected | html %]>[% Data.TenantID | html %]</option>[% RenderBlockEnd("TenantOption") %]</select></form>
  <p><strong>[% Data.Total | html %]</strong> [% Translate("changes") | html %] &middot; [% Data.Awaiting | html %] [% Translate("awaiting CAB") | html %] &middot; [% Data.Scheduled | html %] [% Translate("scheduled") | html %] &middot; [% Data.Implementing | html %] [% Translate("implementing") | html %]</p>
 </div></div>
 <div class="WidgetSimple"><div class="Header"><h2>[% Translate("Register change") | html %]</h2></div><div class="Content">
  <form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentD724Change"/><input type="hidden" name="Subaction" value="Create"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/>
   <fieldset class="TableLike"><label>[% Translate("Title") | html %]</label><input name="Title" maxlength="250" required/>
   <label>[% Translate("Type") | html %]</label><select name="ChangeType"><option value="standard">standard</option><option value="normal" selected>normal</option><option value="emergency">emergency</option></select>
   <label>[% Translate("Impact") | html %]</label><select name="Impact"><option>low</option><option selected>medium</option><option>high</option><option>critical</option></select>
   <label>[% Translate("Likelihood") | html %]</label><select name="Likelihood"><option>low</option><option selected>medium</option><option>high</option><option>critical</option></select>
   <label>[% Translate("Description") | html %]</label><textarea name="Description" maxlength="4000" required></textarea><label>[% Translate("Implementation plan") | html %]</label><textarea name="ImplementationPlan" maxlength="4000" required></textarea><label>[% Translate("Test plan") | html %]</label><textarea name="TestPlan" maxlength="4000" required></textarea><label>[% Translate("Backout plan") | html %]</label><textarea name="BackoutPlan" maxlength="4000" required></textarea></fieldset><button class="Primary" type="submit">[% Translate("Register draft") | html %]</button>
  </form>
 </div></div>
 <div class="WidgetSimple"><div class="Header"><h2>[% Translate("Change and CAB workbench") | html %]</h2></div><div class="Content"><table class="DataTable"><thead><tr><th>[% Translate("Change") | html %]</th><th>[% Translate("Risk") | html %]</th><th>[% Translate("Status") | html %]</th><th>[% Translate("Plans") | html %]</th><th>[% Translate("Actions") | html %]</th></tr></thead><tbody>
[% RenderBlockStart("ChangeRow") %]<tr><td><strong>[% Data.ChangeNumber | html %]</strong><br/>[% Data.Title | html %]<br/><span class="Description">[% Data.ChangeType | html %] &middot; [% Data.CreateTime | html %]</span></td><td><strong>[% Data.RiskLevel | html %]</strong> ([% Data.RiskScore | html %])<br/>[% Data.Impact | html %] &times; [% Data.Likelihood | html %]</td><td>[% Data.Status | html %]<br/><span class="Description">v[% Data.Version | html %]</span></td><td><details><summary>[% Translate("View plans") | html %]</summary><p><strong>[% Translate("Implementation") | html %]:</strong> [% Data.ImplementationPlan | html %]</p><p><strong>[% Translate("Test") | html %]:</strong> [% Data.TestPlan | html %]</p><p><strong>[% Translate("Backout") | html %]:</strong> [% Data.BackoutPlan | html %]</p></details></td><td>
[% RenderBlockStart("SubmitAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentD724Change"/><input type="hidden" name="Subaction" value="Submit"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ChangeID" value="[% Data.ChangeID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button type="submit">[% Translate("Submit") | html %]</button></form>[% RenderBlockEnd("SubmitAction") %]
[% RenderBlockStart("CABAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentD724Change"/><input type="hidden" name="Subaction" value="Decide"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ChangeID" value="[% Data.ChangeID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><input name="Comment" maxlength="2000" placeholder="[% Translate("CAB decision note") | html %]"/><button name="Decision" value="approved" type="submit">[% Translate("Approve") | html %]</button><button name="Decision" value="rejected" type="submit">[% Translate("Reject") | html %]</button></form>[% RenderBlockEnd("CABAction") %]
[% RenderBlockStart("ScheduledAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentD724Change"/><input type="hidden" name="Subaction" value="Transition"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ChangeID" value="[% Data.ChangeID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button name="ToStatus" value="implementing" type="submit">[% Translate("Start") | html %]</button><button name="ToStatus" value="cancelled" type="submit">[% Translate("Cancel") | html %]</button></form>[% RenderBlockEnd("ScheduledAction") %]
[% RenderBlockStart("ImplementingAction") %]<form action="[% Env("CGIHandle") %]" method="post"><input type="hidden" name="Action" value="AgentD724Change"/><input type="hidden" name="Subaction" value="Transition"/><input type="hidden" name="ChallengeToken" value=[% Env("UserChallengeToken") | JSON %]><input type="hidden" name="TenantID" value="[% Data.TenantID | html %]"/><input type="hidden" name="ChangeID" value="[% Data.ChangeID | html %]"/><input type="hidden" name="ExpectedVersion" value="[% Data.Version | html %]"/><button name="ToStatus" value="completed" type="submit">[% Translate("Complete") | html %]</button><button name="ToStatus" value="failed" type="submit">[% Translate("Fail") | html %]</button></form>[% RenderBlockEnd("ImplementingAction") %]
 </td></tr>[% RenderBlockEnd("ChangeRow") %]
 </tbody></table></div></div>
</div>
