<?xml version="1.0" encoding="utf-8" ?>
<careoncloud_package version="1.0">
    <Name>CareOnCloudTenantGuard</Name>
    <Version>0.10.0</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Data Market Bilgi Hizmetleri A.S.</Vendor>
    <URL>https://esm.arcak.net</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Default-deny tenant authorization policy for CareOnCloud ESM.</Description>
    <Description Lang="tr">CareOnCloud ESM icin varsayilan-reddet tenant yetkilendirme politikasi.</Description>
    <PackageRequired Version="0.1.0">CareOnCloudFoundation</PackageRequired>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageIsVisible>1</PackageIsVisible>
    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/CareOnCloudTenantGuard.xml" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/TenantGuard.pm" />
        <File Permission="644" Location="Kernel/System/CareOnCloud/TenantCache.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/TenantGuardCheck.pm" />
        <File Permission="644" Location="Kernel/System/Console/Command/Admin/CareOnCloud/TenantCacheStatus.pm" />
        <File Permission="644" Location="scripts/test/CareOnCloud/TenantGuard.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/TenantGuardAutomation.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/TenantCache.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/TenantCacheStatus.t" />
        <File Permission="644" Location="scripts/test/CareOnCloud/TenantGuardCheck.t" />
    </Filelist>
</careoncloud_package>
