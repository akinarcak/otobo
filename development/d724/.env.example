# Copy this file to .env. Never commit .env.
D724_DB_ROOT_PASSWORD=replace-with-a-long-random-password
D724_HTTP_PORT=8080
D724_ELASTIC_JAVA_OPTS=-Xms512m -Xmx512m

# The PowerShell helper fills these build labels from Git when they are omitted.
# D724_GIT_BRANCH=
# D724_GIT_COMMIT=
# D724_GIT_REPO=
