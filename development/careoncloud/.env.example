# Copy this file to .env. Never commit .env.
CareOnCloud_DB_ROOT_PASSWORD=replace-with-a-long-random-password
CareOnCloud_BIND_ADDRESS=127.0.0.1
CareOnCloud_HTTP_PORT=8080
CareOnCloud_ELASTIC_JAVA_OPTS=-Xms512m -Xmx512m

# The PowerShell helper fills these build labels from Git when they are omitted.
# CareOnCloud_GIT_BRANCH=
# CareOnCloud_GIT_COMMIT=
# CareOnCloud_GIT_REPO=
